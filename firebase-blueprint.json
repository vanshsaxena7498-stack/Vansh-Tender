  "firestore": {
    "/admins/{uid}": {
      "schema": {
        "$ref": "#/entities/AdminMarker"
      },
      "description": "Bootstrapped and explicit admin role markers."
    },
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserAccount"
      },
      "description": "Private root document for each authenticated user's Firestore workspace."
    },
    "/users/{userId}/profile/{profileId}": {
      "schema": {
        "$ref": "#/entities/FirmProfile"
      },
      "description": "Firm profile and admin metadata stored in Firestore."
    },
    "/users/{userId}/settings/{settingId}": {
      "schema": {
        "$ref": "#/entities/UserPreferences"
      },
      "description": "User security PIN and UI theme preferences stored in Firestore."
    },
    "/users/{userId}/tenders/{tenderDocId}": {
      "schema": {
        "$ref": "#/entities/Tender"
      },
      "description": "User's tender records stored exclusively in Firestore."
    },
    "/users/{userId}/emdRecords/{emdDocId}": {
      "schema": {
        "$ref": "#/entities/EmdBgRecord"
      },
      "description": "User's EMD and Bank Guarantee records stored exclusively in Firestore."
    },
    "/users/{userId}/emd_bg_tracker/{emdDocId}": {
      "schema": {
        "$ref": "#/entities/EmdBgRecord"
      },
      "description": "Legacy user-scoped EMD and Bank Guarantee tracker records (read-only recovery for Bootstrapped Admin)."
    },
    "/users/{userId}/attachmentFiles/{attachmentId}": {
      "schema": {
        "$ref": "#/entities/AttachmentFile"
      },
      "description": "Per-attachment binary/dataUrl documents kept under 1 MiB in Firestore."
    },
    "/users/{userId}/maf_tracker/{mafDocId}": {
      "schema": {
        "$ref": "#/entities/MafTracker"
      },
      "description": "Tender-OEM MAF tracker records with nested itemsMAF line items stored exclusively in Firestore."
    },
    "/users/{userId}/emailConfig/{configId}": {
      "schema": {
        "$ref": "#/entities/EmailAlertConfig"
      },
      "description": "User email recipient and twice-daily auto-alert settings."
    },
    "/users/{userId}/emailAlerts/{alertId}": {
      "schema": {
