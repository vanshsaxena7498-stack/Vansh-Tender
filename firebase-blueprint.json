        "updatedAt"
      ]
    },
    "EmailAlertLog": {
      "title": "EmailAlertLog",
      "description": "Deduplicated twice-daily email reminder dispatch logs (11:00 AM IST & 4:00 PM IST) per tender.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "slotKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "tenderRefId": {
          "type": "string",
          "maxLength": 128
        },
        "tenderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "slot": {
          "type": "string",
