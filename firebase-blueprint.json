{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Root owner record for a verified Google-authenticated user backing up CRM data.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the account owner."
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200,
          "description": "Verified Google account email."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when cloud backup was initialized."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest sync."
        }
      },
      "required": ["ownerUid", "email", "createdAt", "updatedAt"]
    },
    "AdminMarker": {
      "title": "AdminMarker",
      "description": "Explicit admin allowlist entry keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "FirmProfile": {
      "title": "FirmProfile",
      "description": "Company profile, GSTIN, Udyam number, and admin display metadata.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "firmName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "gstin": {
          "type": "string",
          "maxLength": 32
        },
        "udyamNumber": {
          "type": "string",
          "maxLength": 40
        },
        "adminName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "adminPhotoUrl": {
          "type": "string",
          "maxLength": 150000,
          "description": "Compact avatar URL or resized data URL kept well below the 1 MiB document ceiling."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerUid",
        "firmName",
        "gstin",
        "udyamNumber",
        "adminName",
        "adminPhotoUrl",
        "createdAt",
        "updatedAt"
      ]
    },
    "Tender": {
      "title": "Tender",
      "description": "Individual tender/bid record tracked in Daily Tender Operations.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "tenderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "portal": {
          "type": "string",
          "enum": ["GeM", "CPPP / eProcure", "State Portal", "PSU / Direct", "Private"],
          "maxLength": 40
        },
        "department": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "location": {
          "type": "string",
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "maxLength": 120
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "publishDate": {
          "type": "string",
          "maxLength": 32
        },
        "submissionDueDate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "preBidDate": {
          "type": "string",
          "maxLength": 32
        },
        "estimatedValue": {
          "type": "number"
        },
        "quotedValue": {
          "type": "number"
        },
        "emdStatus": {
          "type": "string",
          "enum": ["Exempted - MSME/Startup", "EMD Paid", "BG Submitted", "No EMD"],
          "maxLength": 40
        },
        "emdAmount": {
          "type": "number"
        },
        "stage": {
          "type": "string",
          "enum": [
            "Identified / Reviewing",
            "Doc Preparation",
            "Submitted",
            "Technical Eval",
            "Financial / BOQ Eval",
            "L1 / Won",
            "Lost (L2/L3)",
            "Cancelled / Retendered"
          ],
          "maxLength": 40
        },
        "resultInfo": {
          "type": "string",
          "maxLength": 1000
        },
        "completionDate": {
          "type": "string",
          "maxLength": 32
        },
        "checklist": {
          "type": "array",
          "description": "Bounded document readiness checklist items (max 30)."
        },
        "remarks": {
          "type": "array",
          "description": "Bounded timestamped follow-up notes (max 100)."
        },
        "attachments": {
          "type": "array",
          "description": "Bounded attachment metadata list (max 10; oversized binary payloads stripped before cloud write)."
        },
        "clientCreatedAt": {
          "type": "string",
          "maxLength": 40
        },
        "clientUpdatedAt": {
          "type": "string",
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerUid",
        "id",
        "tenderId",
        "portal",
        "department",
        "location",
        "category",
        "title",
        "publishDate",
        "submissionDueDate",
        "preBidDate",
        "estimatedValue",
        "quotedValue",
        "emdStatus",
        "emdAmount",
        "stage",
        "resultInfo",
        "completionDate",
        "checklist",
        "remarks",
        "attachments",
        "clientCreatedAt",
        "clientUpdatedAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "EmdBgRecord": {
      "title": "EmdBgRecord",
      "description": "EMD, Demand Draft, FDR, or Bank Guarantee financial instrument record.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "tenderRefId": {
          "type": "string",
          "maxLength": 128
        },
        "tenderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "department": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "instrumentType": {
          "type": "string",
          "enum": [
            "Online / NEFT / RTGS",
            "Demand Draft (DD)",
            "Bank Guarantee (PBG / Bid BG)",
            "FDR / TDR",
            "e-PBG"
          ],
          "maxLength": 50
        },
        "referenceNo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "bankName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "amount": {
          "type": "number"
        },
        "issueDate": {
          "type": "string",
          "maxLength": 32
        },
        "expiryDate": {
          "type": "string",
          "maxLength": 32
        },
        "claimEndDate": {
          "type": "string",
          "maxLength": 32
        },
        "status": {
          "type": "string",
          "enum": [
            "Active / Locked",
            "Extension Requested",
            "Refund / Release Applied",
            "Refunded / Released",
            "Forfeited"
          ],
          "maxLength": 40
        },
        "refundDate": {
          "type": "string",
          "maxLength": 32
        },
        "refundRef": {
          "type": "string",
          "maxLength": 120
        },
        "remarks": {
          "type": "string",
          "maxLength": 1000
        },
        "attachments": {
          "type": "array",
          "description": "Bounded attachment metadata list (max 10; oversized binary payloads stripped before cloud write)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerUid",
        "id",
        "tenderRefId",
        "tenderId",
        "department",
        "instrumentType",
        "referenceNo",
        "bankName",
        "amount",
        "issueDate",
        "expiryDate",
        "claimEndDate",
        "status",
        "refundDate",
        "refundRef",
        "remarks",
        "attachments",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/admins/{uid}": {
      "schema": {
        "$ref": "#/entities/AdminMarker"
      },
      "description": "Bootstrapped and explicit admin role markers."
    },
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserAccount"
      },
      "description": "Private root document for each authenticated user's cloud backup space."
    },
    "/users/{userId}/profile/{profileId}": {
      "schema": {
        "$ref": "#/entities/FirmProfile"
      },
      "description": "Firm profile and admin configuration synced to Google Cloud."
    },
    "/users/{userId}/tenders/{tenderDocId}": {
      "schema": {
        "$ref": "#/entities/Tender"
      },
      "description": "User's backed-up tender records."
    },
    "/users/{userId}/emdRecords/{emdDocId}": {
      "schema": {
        "$ref": "#/entities/EmdBgRecord"
      },
      "description": "User's backed-up EMD and Bank Guarantee records."
    }
  }
}
