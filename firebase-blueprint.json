          "type": "string",
          "maxLength": 100
        },
        "recipientEmail": {
          "type": "string",
          "maxLength": 160
        },
        "dueDateIso": {
          "type": "string",
          "maxLength": 40
        },
        "status": {
          "type": "string",
          "enum": ["sent", "failed"],
          "maxLength": 24
        },
        "provider": {
          "type": "string",
          "maxLength": 40
        },
        "subject": {
          "type": "string",
          "maxLength": 240
        },
        "message": {
          "type": "string",
          "maxLength": 4000
        },
        "clientCreatedAt": {
          "type": "string",
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerUid",
        "id",
        "slotKey",
        "tenderRefId",
        "tenderId",
        "slot",
        "recipientName",
        "recipientEmail",
        "dueDateIso",
        "status",
        "provider",
        "subject",
        "message",
        "clientCreatedAt",
        "createdAt",
        "updatedAt"
      ]
    },
