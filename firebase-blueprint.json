{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Root owner record for a verified Google-authenticated user storing CRM data exclusively in Firestore.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the account owner."
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200,
          "description": "Verified Google account email."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerUid", "email", "createdAt", "updatedAt"]
    },
    "AdminMarker": {
      "title": "AdminMarker",
      "description": "Explicit admin allowlist entry keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "UserPreferences": {
      "title": "UserPreferences",
      "description": "Admin lock PIN and theme preferences persisted exclusively in Firestore.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "adminPin": {
          "type": "string",
          "minLength": 4,
          "maxLength": 4,
          "pattern": "^[0-9]{4}$"
        },
        "darkMode": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerUid", "adminPin", "darkMode", "createdAt", "updatedAt"]
    },
    "FirmProfile": {
      "title": "FirmProfile",
      "description": "Company profile, GSTIN, Udyam number, and compressed admin avatar.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "firmName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "gstin": {
          "type": "string",
          "maxLength": 32
        },
        "udyamNumber": {
          "type": "string",
          "maxLength": 40
        },
        "adminName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "adminPhotoUrl": {
          "type": "string",
          "maxLength": 150000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerUid",
        "firmName",
        "gstin",
        "udyamNumber",
        "adminName",
        "adminPhotoUrl",
        "createdAt",
        "updatedAt"
      ]
    },
    "AttachmentFile": {
      "title": "AttachmentFile",
      "description": "Dedicated Firestore file payload for a tender or EMD/BG attachment (kept < 1 MiB).",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "fileType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "fileSize": {
          "type": "number"
        },
        "dataUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 950000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerUid",
        "id",
        "fileName",
        "fileType",
        "fileSize",
        "dataUrl",
        "createdAt",
        "updatedAt"
      ]
    },
    "Tender": {
      "title": "Tender",
      "description": "Individual tender/bid record stored exclusively in Firestore.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "tenderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "portal": {
          "type": "string",
          "enum": ["GeM", "CPPP / eProcure", "State Portal", "PSU / Direct", "Private"],
          "maxLength": 40
        },
        "clientName": {
          "type": "string",
          "maxLength": 200
        },
        "department": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "locationDepartment": {
          "type": "string",
          "maxLength": 200
        },
        "location": {
          "type": "string",
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "maxLength": 120
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "publishDate": {
          "type": "string",
          "maxLength": 32
        },
        "submissionDueDate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "preBidDate": {
          "type": "string",
          "maxLength": 32
        },
        "technicalOpeningDate": {
          "type": "string",
          "maxLength": 32
        },
        "financialOpeningDate": {
          "type": "string",
          "maxLength": 32
        },
        "estimatedValue": {
          "type": "number"
        },
        "quotedValue": {
          "type": "number"
        },
        "l1BidderName": {
          "type": "string",
          "maxLength": 200
        },
        "l1QuotedValue": {
          "type": "number"
        },
        "ourPositionRank": {
          "type": "string",
          "maxLength": 40
        },
        "assignedOwner": {
          "type": "string",
          "maxLength": 100
        },
        "emdStatus": {
          "type": "string",
          "enum": ["Exempted - MSME/Startup", "EMD Paid", "BG Submitted", "No EMD"],
          "maxLength": 40
        },
        "emdAmount": {
          "type": "number"
        },
        "stage": {
          "type": "string",
          "enum": [
            "Identified / Reviewing",
            "Doc Preparation",
            "Submitted",
            "Technical Eval",
            "Financial / BOQ Eval",
            "L1 / Won",
            "Lost (L2/L3)",
            "Cancelled / Retendered",
            "Tender Not Filled"
          ],
          "maxLength": 40
        },
        "resultInfo": {
          "type": "string",
          "maxLength": 1000
        },
        "completionDate": {
          "type": "string",
          "maxLength": 32
        },
        "checklist": {
          "type": "array"
        },
        "remarks": {
          "type": "array"
        },
        "attachments": {
          "type": "array"
        },
        "clientCreatedAt": {
          "type": "string",
          "maxLength": 40
        },
        "clientUpdatedAt": {
          "type": "string",
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerUid",
        "id",
        "tenderId",
        "portal",
        "clientName",
        "department",
        "locationDepartment",
        "location",
        "category",
        "title",
        "publishDate",
        "submissionDueDate",
        "preBidDate",
        "technicalOpeningDate",
        "financialOpeningDate",
        "estimatedValue",
        "quotedValue",
        "l1BidderName",
        "l1QuotedValue",
        "ourPositionRank",
        "assignedOwner",
        "emdStatus",
        "emdAmount",
        "stage",
        "resultInfo",
        "completionDate",
        "checklist",
        "remarks",
        "attachments",
        "clientCreatedAt",
        "clientUpdatedAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "EmdBgRecord": {
      "title": "EmdBgRecord",
      "description": "EMD, Demand Draft, FDR, or Bank Guarantee financial instrument record.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "tenderRefId": {
          "type": "string",
          "maxLength": 128
        },
        "tenderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "department": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "instrumentType": {
          "type": "string",
          "enum": [
            "Online / NEFT / RTGS",
            "Demand Draft (DD)",
            "Bank Guarantee (PBG / Bid BG)",
            "FDR / TDR",
            "e-PBG"
          ],
          "maxLength": 50
        },
        "referenceNo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "bankName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "amount": {
          "type": "number"
        },
        "issueDate": {
          "type": "string",
          "maxLength": 32
        },
        "expiryDate": {
          "type": "string",
          "maxLength": 32
        },
        "claimEndDate": {
          "type": "string",
          "maxLength": 32
        },
        "status": {
          "type": "string",
          "enum": [
            "Active / Locked",
            "Extension Requested",
            "Refund / Release Applied",
            "Refunded / Released",
            "Forfeited"
          ],
          "maxLength": 40
        },
        "refundDate": {
          "type": "string",
          "maxLength": 32
        },
        "refundRef": {
          "type": "string",
          "maxLength": 120
        },
        "remarks": {
          "type": "string",
          "maxLength": 1000
        },
        "attachments": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerUid",
        "id",
        "tenderRefId",
        "tenderId",
        "department",
        "instrumentType",
        "referenceNo",
        "bankName",
        "amount",
        "issueDate",
        "expiryDate",
        "claimEndDate",
        "status",
        "refundDate",
        "refundRef",
        "remarks",
        "attachments",
        "createdAt",
        "updatedAt"
      ]
    },
