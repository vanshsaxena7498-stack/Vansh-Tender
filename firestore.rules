            incoming().updatedAt == request.time &&
            hasValidWorkspace(userId, tenantId);
          allow update: if isVerifiedUser() &&
            isValidId(userId) &&
            isValidId(tenantId) &&
            isValidId(alertId) &&
            isValidEmailAlertLog(incoming(), userId, alertId) &&
            (!('ownerUid' in existing()) || !(existing().ownerUid is string) || existing().ownerUid == '' || incoming().ownerUid == existing().ownerUid || isAdmin()) &&
            (!('id' in existing()) || !(existing().id is string) || existing().id != alertId || incoming().id == existing().id) &&
            (!('createdAt' in existing()) || !(existing().createdAt is timestamp) ? incoming().createdAt == request.time : incoming().createdAt == existing().createdAt) &&
            incoming().updatedAt == request.time &&
            (
              (
                isOwner(userId) &&
                incoming().diff(existing()).addedKeys().hasOnly([
                  'ownerUid',
                  'id',
                  'slotKey',
                  'tenderRefId',
                  'tenderId',
                  'slot',
                  'recipientName',
                  'recipientEmail',
                  'dueDateIso',
                  'status',
                  'provider',
                  'subject',
                  'message',
                  'clientCreatedAt',
                  'createdAt',
                  'updatedAt'
                ]) &&
                incoming().diff(existing()).changedKeys().hasOnly([
                  'ownerUid',
                  'id',
                  'slotKey',
                  'tenderRefId',
                  'tenderId',
                  'slot',
                  'recipientName',
                  'recipientEmail',
                  'dueDateIso',
                  'status',
                  'provider',
                  'subject',
                  'message',
                  'clientCreatedAt',
                  'createdAt',
                  'updatedAt'
                ])
              ) ||
              isAdmin()
            ) &&
            hasValidWorkspace(userId, tenantId);
          allow delete: if isVerifiedUser() &&
            isValidId(userId) &&
            isValidId(tenantId) &&
            isValidId(alertId) &&
            (isOwner(userId) || isAdmin()) &&
            hasValidWorkspace(userId, tenantId);
        }

        match /sheetConfig/{configId} {
          allow get: if isVerifiedUser() &&
            isValidId(userId) &&
            isValidId(tenantId) &&
            isValidId(configId) &&
            (isOwner(userId) || isAdmin()) &&
            hasValidWorkspace(userId, tenantId);
          allow list: if isVerifiedUser() &&
            request.auth.uid == userId &&
            resource.data.ownerUid == request.auth.uid;
          allow create: if isVerifiedUser() &&
            isValidId(userId) &&
            isValidId(tenantId) &&
            isValidId(configId) &&
            configId == 'default' &&
            isOwner(userId) &&
            isValidSheetConfig(incoming(), userId) &&
            incoming().createdAt == request.time &&
            incoming().updatedAt == request.time &&
            hasValidWorkspace(userId, tenantId);
          allow update: if isVerifiedUser() &&
            isValidId(userId) &&
            isValidId(tenantId) &&
            isValidId(configId) &&
            configId == 'default' &&
            isValidSheetConfig(incoming(), userId) &&
            (!('ownerUid' in existing()) || !(existing().ownerUid is string) || existing().ownerUid == '' || incoming().ownerUid == existing().ownerUid || isAdmin()) &&
            (!('createdAt' in existing()) || !(existing().createdAt is timestamp) ? incoming().createdAt == request.time : incoming().createdAt == existing().createdAt) &&
            incoming().updatedAt == request.time &&
            (
              (
                isOwner(userId) &&
                incoming().diff(existing()).addedKeys().hasOnly([
                  'ownerUid',
                  'enabled',
                  'webhookUrl',
                  'sheetName',
                  'lastSyncedAt',
                  'createdAt',
                  'updatedAt'
                ]) &&
                incoming().diff(existing()).changedKeys().hasOnly([
                  'ownerUid',
                  'enabled',
                  'webhookUrl',
                  'sheetName',
                  'lastSyncedAt',
                  'createdAt',
                  'updatedAt'
                ])
              ) ||
              isAdmin()
            ) &&
            hasValidWorkspace(userId, tenantId);
          allow delete: if isVerifiedUser() &&
            isValidId(userId) &&
            isValidId(tenantId) &&
            isValidId(configId) &&
            (isOwner(userId) || isAdmin()) &&
            hasValidWorkspace(userId, tenantId);
        }
      }
    }

    match /secondaryUsers/{secondaryUserId} {
      allow get: if isVerifiedUser() &&
        isValidId(secondaryUserId) &&
        (isAdmin() || existing().ownerUid == request.auth.uid);
      allow list: if isVerifiedUser() &&
        (isBootstrappedAdmin() || resource.data.ownerUid == request.auth.uid);
      allow create: if isVerifiedUser() &&
        isValidId(secondaryUserId) &&
        isValidSecondaryUserRecord(incoming(), secondaryUserId) &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(secondaryUserId) &&
        isValidSecondaryUserRecord(incoming(), secondaryUserId) &&
        (!('ownerUid' in existing()) || !(existing().ownerUid is string) || existing().ownerUid == '' || incoming().ownerUid == existing().ownerUid || isAdmin()) &&
        (!('userId' in existing()) || !(existing().userId is string) || existing().userId != secondaryUserId || incoming().userId == existing().userId) &&
        (!('createdAt' in existing()) || !(existing().createdAt is timestamp) ? incoming().createdAt == request.time : incoming().createdAt == existing().createdAt) &&
        incoming().updatedAt == request.time &&
        (
          (
            existing().ownerUid == request.auth.uid &&
            incoming().diff(existing()).addedKeys().hasOnly([
              'username',
              'email',
              'isActive',
              'presenceStatus',
              'lastHeartbeatAt',
              'lastLogoutAt',
              'byocProjectId',
              'clientLastLoginAt',
              'createdAt',
              'updatedAt'
            ]) &&
            incoming().diff(existing()).changedKeys().hasOnly([
              'username',
              'email',
              'isActive',
              'presenceStatus',
              'lastHeartbeatAt',
              'lastLogoutAt',
              'byocProjectId',
              'clientLastLoginAt',
              'createdAt',
              'updatedAt'
            ])
          ) ||
          isAdmin()
        );
      allow delete: if isVerifiedUser() &&
        isValidId(secondaryUserId) &&
        isAdmin();
    }

    // Legacy top-level collections: strictly read-only for Bootstrapped Primary Admin recovery
    match /tenders/{docId} {
      allow get: if isBootstrappedAdmin() && isValidId(docId);
      allow list: if isBootstrappedAdmin();
      allow create, update, delete: if false;
    }

    match /emdRecords/{docId} {
      allow get: if isBootstrappedAdmin() && isValidId(docId);
      allow list: if isBootstrappedAdmin();
      allow create, update, delete: if false;
    }

    match /emd_bg_tracker/{docId} {
      allow get: if isBootstrappedAdmin() && isValidId(docId);
      allow list: if isBootstrappedAdmin();
      allow create, update, delete: if false;
    }

    match /maf_tracker/{docId} {
      allow get: if isBootstrappedAdmin() && isValidId(docId);
      allow list: if isBootstrappedAdmin();
      allow create, update, delete: if false;
    }

    match /attachmentFiles/{docId} {
      allow get: if isBootstrappedAdmin() && isValidId(docId);
      allow list: if isBootstrappedAdmin();
      allow create, update, delete: if false;
    }

    match /settings/{docId} {
      allow get: if isBootstrappedAdmin() && isValidId(docId);
      allow list: if isBootstrappedAdmin();
      allow create, update, delete: if false;
    }

    match /profile/{docId} {
      allow get: if isBootstrappedAdmin() && isValidId(docId);
      allow list: if isBootstrappedAdmin();
      allow create, update, delete: if false;
    }

    match /sheetConfig/{docId} {
      allow get: if isBootstrappedAdmin() && isValidId(docId);
      allow list: if isBootstrappedAdmin();
      allow create, update, delete: if false;
    }

    match /emailConfig/{docId} {
      allow get: if isBootstrappedAdmin() && isValidId(docId);
      allow list: if isBootstrappedAdmin();
      allow create, update, delete: if false;
    }

    match /emailAlerts/{docId} {
      allow get: if isBootstrappedAdmin() && isValidId(docId);
      allow list: if isBootstrappedAdmin();
      allow create, update, delete: if false;
    }

    match /oemDetails/{docId} {
      allow get: if isBootstrappedAdmin() && isValidId(docId);
      allow list: if isBootstrappedAdmin();
      allow create, update, delete: if false;
    }
  }
}
