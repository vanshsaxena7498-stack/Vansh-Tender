rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Global Helpers
    // -------------------------------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'vanshsaxena7498@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function hasValidParentUser(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)) &&
        get(/databases/$(database)/documents/users/$(userId)).data.ownerUid == userId;
    }

    function isValidPortal(portal) {
      return portal in ['GeM', 'CPPP / eProcure', 'State Portal', 'PSU / Direct', 'Private'];
    }

    function isValidEmdStatus(emdStatus) {
      return emdStatus in ['Exempted - MSME/Startup', 'EMD Paid', 'BG Submitted', 'No EMD'];
    }

    function isValidTenderStage(stage) {
      return stage in [
        'Identified / Reviewing',
        'Doc Preparation',
        'Submitted',
        'Technical Eval',
        'Financial / BOQ Eval',
        'L1 / Won',
        'Lost (L2/L3)',
        'Cancelled / Retendered',
        'Tender Not Filled'
      ];
    }

    function isTerminalTenderStage(stage) {
      return stage in ['L1 / Won', 'Lost (L2/L3)', 'Cancelled / Retendered'];
    }

    function isValidInstrumentType(instrumentType) {
      return instrumentType in [
        'Online / NEFT / RTGS',
        'Demand Draft (DD)',
        'Bank Guarantee (PBG / Bid BG)',
        'FDR / TDR',
        'e-PBG'
      ];
    }

    function isValidFinancialStatus(status) {
      return status in [
        'Active / Locked',
        'Extension Requested',
        'Refund / Release Applied',
        'Refunded / Released',
        'Forfeited'
      ];
    }

    function isTerminalFinancialStatus(status) {
      return status in ['Refunded / Released', 'Forfeited'];
    }

    function isValidWhatsAppMilestone(milestone) {
      return milestone in ['alert_48h', 'urgent_4h', 'test'];
    }

    function isValidWhatsAppStatus(status) {
      return status in ['sent', 'manual_ready', 'failed'];
    }

    // -------------------------------------------------------------------------
    // Entity Validation Blueprints (No existing()/diff() inside helpers!)
    // -------------------------------------------------------------------------
    function isValidUserAccount(data, userId) {
      return data.keys().hasAll(['ownerUid', 'email', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerUid', 'email', 'createdAt', 'updatedAt']) &&
        isValidId(data.ownerUid) &&
        data.ownerUid == userId &&
        data.ownerUid == request.auth.uid &&
        data.email is string &&
        data.email.size() <= 200 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAdminMarker(data, uid) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'createdAt']) &&
        isValidId(data.uid) &&
        data.uid == uid &&
        data.email is string &&
        data.email.size() >= 3 &&
        data.email.size() <= 200 &&
        data.createdAt is timestamp;
    }

    function isValidUserPreferences(data, userId) {
      return data.keys().hasAll(['ownerUid', 'adminPin', 'darkMode', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerUid', 'adminPin', 'darkMode', 'createdAt', 'updatedAt']) &&
        isValidId(data.ownerUid) &&
        data.ownerUid == userId &&
        data.ownerUid == request.auth.uid &&
        data.adminPin is string &&
        data.adminPin.size() == 4 &&
        data.adminPin.matches('^[0-9]{4}$') &&
        data.darkMode is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidFirmProfile(data, userId) {
      return data.keys().hasAll([
          'ownerUid',
          'firmName',
          'gstin',
          'udyamNumber',
          'adminName',
          'adminPhotoUrl',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerUid',
          'firmName',
          'gstin',
          'udyamNumber',
          'adminName',
          'adminPhotoUrl',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.ownerUid) &&
        data.ownerUid == userId &&
        data.ownerUid == request.auth.uid &&
        data.firmName is string &&
        data.firmName.size() >= 1 &&
        data.firmName.size() <= 150 &&
        data.gstin is string &&
        data.gstin.size() <= 32 &&
        data.udyamNumber is string &&
        data.udyamNumber.size() <= 40 &&
        data.adminName is string &&
        data.adminName.size() >= 1 &&
        data.adminName.size() <= 100 &&
        data.adminPhotoUrl is string &&
        data.adminPhotoUrl.size() <= 150000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAttachmentFile(data, userId, attachmentId) {
      return data.keys().hasAll([
          'ownerUid',
          'id',
          'fileName',
          'fileType',
          'fileSize',
          'dataUrl',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerUid',
          'id',
          'fileName',
          'fileType',
          'fileSize',
          'dataUrl',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.ownerUid) &&
        data.ownerUid == userId &&
        data.ownerUid == request.auth.uid &&
        isValidId(data.id) &&
        data.id == attachmentId &&
        data.fileName is string &&
        data.fileName.size() >= 1 &&
        data.fileName.size() <= 200 &&
        data.fileType is string &&
        data.fileType.size() >= 1 &&
        data.fileType.size() <= 120 &&
        data.fileSize is number &&
        data.fileSize >= 0 &&
        data.dataUrl is string &&
        data.dataUrl.size() >= 1 &&
        data.dataUrl.size() <= 950000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidTender(data, userId, tenderDocId) {
      return data.keys().hasAll([
          'ownerUid',
          'id',
          'tenderId',
          'portal',
          'department',
          'location',
          'category',
          'title',
          'publishDate',
          'submissionDueDate',
          'preBidDate',
          'estimatedValue',
          'quotedValue',
          'emdStatus',
          'emdAmount',
          'stage',
          'resultInfo',
          'completionDate',
          'checklist',
          'remarks',
          'attachments',
          'clientCreatedAt',
          'clientUpdatedAt',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerUid',
          'id',
          'tenderId',
          'portal',
          'department',
          'location',
          'category',
          'title',
          'publishDate',
          'submissionDueDate',
          'preBidDate',
          'estimatedValue',
          'quotedValue',
          'emdStatus',
          'emdAmount',
          'stage',
          'resultInfo',
          'completionDate',
          'checklist',
          'remarks',
          'attachments',
          'clientCreatedAt',
          'clientUpdatedAt',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.ownerUid) &&
        data.ownerUid == userId &&
        data.ownerUid == request.auth.uid &&
        isValidId(data.id) &&
        data.id == tenderDocId &&
        data.tenderId is string &&
        data.tenderId.size() >= 1 &&
        data.tenderId.size() <= 120 &&
        data.portal is string &&
        data.portal.size() <= 40 &&
        isValidPortal(data.portal) &&
        data.department is string &&
        data.department.size() >= 1 &&
        data.department.size() <= 200 &&
        data.location is string &&
        data.location.size() <= 120 &&
        data.category is string &&
        data.category.size() <= 120 &&
        data.title is string &&
        data.title.size() >= 1 &&
        data.title.size() <= 300 &&
        data.publishDate is string &&
        data.publishDate.size() <= 32 &&
        data.submissionDueDate is string &&
        data.submissionDueDate.size() >= 1 &&
        data.submissionDueDate.size() <= 32 &&
        data.preBidDate is string &&
        data.preBidDate.size() <= 32 &&
        data.estimatedValue is number &&
        data.estimatedValue >= 0 &&
        data.quotedValue is number &&
        data.quotedValue >= 0 &&
        data.emdStatus is string &&
        data.emdStatus.size() <= 40 &&
        isValidEmdStatus(data.emdStatus) &&
        data.emdAmount is number &&
        data.emdAmount >= 0 &&
        data.stage is string &&
        data.stage.size() <= 40 &&
        isValidTenderStage(data.stage) &&
        data.resultInfo is string &&
        data.resultInfo.size() <= 1000 &&
        data.completionDate is string &&
        data.completionDate.size() <= 32 &&
        data.checklist is list &&
        data.checklist.size() <= 30 &&
        (data.checklist.size() == 0 || data.checklist[0] is map) &&
        data.remarks is list &&
        data.remarks.size() <= 100 &&
        (data.remarks.size() == 0 || data.remarks[0] is map) &&
        data.attachments is list &&
        data.attachments.size() <= 10 &&
        (data.attachments.size() == 0 || data.attachments[0] is map) &&
        data.clientCreatedAt is string &&
        data.clientCreatedAt.size() <= 40 &&
        data.clientUpdatedAt is string &&
        data.clientUpdatedAt.size() <= 40 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidEmdRecord(data, userId, emdDocId) {
      return data.keys().hasAll([
          'ownerUid',
          'id',
          'tenderRefId',
          'tenderId',
          'department',
          'instrumentType',
          'referenceNo',
          'bankName',
          'amount',
          'issueDate',
          'expiryDate',
          'claimEndDate',
          'status',
          'refundDate',
          'refundRef',
          'remarks',
          'attachments',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerUid',
          'id',
          'tenderRefId',
          'tenderId',
          'department',
          'instrumentType',
          'referenceNo',
          'bankName',
          'amount',
          'issueDate',
          'expiryDate',
          'claimEndDate',
          'status',
          'refundDate',
          'refundRef',
          'remarks',
          'attachments',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.ownerUid) &&
        data.ownerUid == userId &&
        data.ownerUid == request.auth.uid &&
        isValidId(data.id) &&
        data.id == emdDocId &&
        data.tenderRefId is string &&
        data.tenderRefId.size() <= 128 &&
        data.tenderId is string &&
        data.tenderId.size() >= 1 &&
        data.tenderId.size() <= 120 &&
        data.department is string &&
        data.department.size() >= 1 &&
        data.department.size() <= 200 &&
        data.instrumentType is string &&
        data.instrumentType.size() <= 50 &&
        isValidInstrumentType(data.instrumentType) &&
        data.referenceNo is string &&
        data.referenceNo.size() >= 1 &&
        data.referenceNo.size() <= 120 &&
        data.bankName is string &&
        data.bankName.size() >= 1 &&
        data.bankName.size() <= 150 &&
        data.amount is number &&
        data.amount >= 0 &&
        data.issueDate is string &&
        data.issueDate.size() <= 32 &&
        data.expiryDate is string &&
        data.expiryDate.size() <= 32 &&
        data.claimEndDate is string &&
        data.claimEndDate.size() <= 32 &&
        data.status is string &&
        data.status.size() <= 40 &&
        isValidFinancialStatus(data.status) &&
        data.refundDate is string &&
        data.refundDate.size() <= 32 &&
        data.refundRef is string &&
        data.refundRef.size() <= 120 &&
        data.remarks is string &&
        data.remarks.size() <= 1000 &&
        data.attachments is list &&
        data.attachments.size() <= 10 &&
        (data.attachments.size() == 0 || data.attachments[0] is map) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidMafTracker(data, userId, mafDocId) {
      return data.keys().hasAll([
          'ownerUid',
          'id',
          'tenderRefId',
          'tenderId',
          'tenderTitle',
          'department',
          'tenderDueDate',
          'itemsMAF',
          'clientCreatedAt',
          'clientUpdatedAt',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerUid',
          'id',
          'tenderRefId',
          'tenderId',
          'tenderTitle',
          'department',
          'tenderDueDate',
          'itemsMAF',
          'clientCreatedAt',
          'clientUpdatedAt',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.ownerUid) &&
        data.ownerUid == userId &&
        data.ownerUid == request.auth.uid &&
        isValidId(data.id) &&
        data.id == mafDocId &&
        data.tenderRefId is string &&
        data.tenderRefId.size() <= 128 &&
        data.tenderId is string &&
        data.tenderId.size() >= 1 &&
        data.tenderId.size() <= 120 &&
        data.tenderTitle is string &&
        data.tenderTitle.size() <= 300 &&
        data.department is string &&
        data.department.size() <= 200 &&
        data.tenderDueDate is string &&
        data.tenderDueDate.size() <= 32 &&
        data.itemsMAF is list &&
        data.itemsMAF.size() <= 50 &&
        (data.itemsMAF.size() == 0 || data.itemsMAF[0] is map) &&
        data.clientCreatedAt is string &&
        data.clientCreatedAt.size() <= 40 &&
        data.clientUpdatedAt is string &&
        data.clientUpdatedAt.size() <= 40 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidWhatsAppConfig(data, userId) {
      return data.keys().hasAll([
          'ownerUid',
          'enabled',
          'recipientName',
          'recipientPhone',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerUid',
          'enabled',
          'recipientName',
          'recipientPhone',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.ownerUid) &&
        data.ownerUid == userId &&
        data.ownerUid == request.auth.uid &&
        data.enabled is bool &&
        data.recipientName is string &&
        data.recipientName.size() >= 1 &&
        data.recipientName.size() <= 100 &&
        data.recipientPhone is string &&
        data.recipientPhone.size() >= 10 &&
        data.recipientPhone.size() <= 20 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidWhatsAppAlertLog(data, userId, alertId) {
      return data.keys().hasAll([
          'ownerUid',
          'id',
          'milestoneKey',
          'tenderRefId',
          'tenderId',
          'milestone',
          'recipientName',
          'recipientPhone',
          'dueDateIso',
          'status',
          'provider',
          'message',
          'clientCreatedAt',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerUid',
          'id',
          'milestoneKey',
          'tenderRefId',
          'tenderId',
          'milestone',
          'recipientName',
          'recipientPhone',
          'dueDateIso',
          'status',
          'provider',
          'message',
          'clientCreatedAt',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.ownerUid) &&
        data.ownerUid == userId &&
        data.ownerUid == request.auth.uid &&
        isValidId(data.id) &&
        data.id == alertId &&
        data.milestoneKey is string &&
        data.milestoneKey.size() >= 1 &&
        data.milestoneKey.size() <= 150 &&
        data.tenderRefId is string &&
        data.tenderRefId.size() <= 128 &&
        data.tenderId is string &&
        data.tenderId.size() >= 1 &&
        data.tenderId.size() <= 120 &&
        data.milestone is string &&
        data.milestone.size() <= 24 &&
        isValidWhatsAppMilestone(data.milestone) &&
        data.recipientName is string &&
        data.recipientName.size() <= 100 &&
        data.recipientPhone is string &&
        data.recipientPhone.size() <= 24 &&
        data.dueDateIso is string &&
        data.dueDateIso.size() <= 40 &&
        data.status is string &&
        data.status.size() <= 24 &&
        isValidWhatsAppStatus(data.status) &&
        data.provider is string &&
        data.provider.size() <= 40 &&
        data.message is string &&
        data.message.size() <= 3000 &&
        data.clientCreatedAt is string &&
        data.clientCreatedAt.size() <= 40 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSheetConfig(data, userId) {
      return data.keys().hasAll([
          'ownerUid',
          'enabled',
          'webhookUrl',
          'sheetName',
          'lastSyncedAt',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerUid',
          'enabled',
          'webhookUrl',
          'sheetName',
          'lastSyncedAt',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.ownerUid) &&
        data.ownerUid == userId &&
        data.ownerUid == request.auth.uid &&
        data.enabled is bool &&
        data.webhookUrl is string &&
        data.webhookUrl.size() <= 500 &&
        (data.webhookUrl == '' || data.webhookUrl.matches('^https://.*')) &&
        data.sheetName is string &&
        data.sheetName.size() >= 1 &&
        data.sheetName.size() <= 120 &&
        data.lastSyncedAt is string &&
        data.lastSyncedAt.size() <= 40 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------
    match /admins/{uid} {
      allow get: if isVerifiedUser() && isValidId(uid) && (request.auth.uid == uid || isAdmin());
      allow list: if false;
      allow create: if isVerifiedUser() &&
        isValidId(uid) &&
        isValidAdminMarker(incoming(), uid) &&
        incoming().createdAt == request.time &&
        isBootstrappedAdmin();
      allow update: if isVerifiedUser() &&
        isValidId(uid) &&
        isValidAdminMarker(incoming(), uid) &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email']) &&
        isBootstrappedAdmin();
      allow delete: if isVerifiedUser() && isValidId(uid) && isBootstrappedAdmin();
    }

    match /users/{userId} {
      allow get: if isVerifiedUser() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;
      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidUserAccount(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidUserAccount(incoming(), userId) &&
        (!('ownerUid' in existing()) || incoming().ownerUid == existing().ownerUid) &&
        (!('createdAt' in existing()) ? incoming().createdAt == request.time : incoming().createdAt == existing().createdAt) &&
        incoming().updatedAt == request.time &&
        (
          (
            isOwner(userId) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['ownerUid', 'email', 'createdAt', 'updatedAt'])
          ) ||
          isAdmin()
        );
      allow delete: if isVerifiedUser() && isValidId(userId) && isAdmin();

      match /profile/{profileId} {
        allow get: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(profileId) &&
          (isOwner(userId) || isAdmin()) &&
          hasValidParentUser(userId);
        allow list: if isVerifiedUser() &&
          request.auth.uid == userId &&
          resource.data.ownerUid == request.auth.uid;
        allow create: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(profileId) &&
          profileId == 'firm' &&
          isOwner(userId) &&
          isValidFirmProfile(incoming(), userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          hasValidParentUser(userId);
        allow update: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(profileId) &&
          profileId == 'firm' &&
          isValidFirmProfile(incoming(), userId) &&
          (!('ownerUid' in existing()) || incoming().ownerUid == existing().ownerUid) &&
          (!('createdAt' in existing()) ? incoming().createdAt == request.time : incoming().createdAt == existing().createdAt) &&
          incoming().updatedAt == request.time &&
          (
            (
              isOwner(userId) &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'ownerUid',
                'firmName',
                'gstin',
                'udyamNumber',
                'adminName',
                'adminPhotoUrl',
                'createdAt',
                'updatedAt'
              ])
            ) ||
            isAdmin()
          ) &&
          hasValidParentUser(userId);
        allow delete: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(profileId) &&
          (isOwner(userId) || isAdmin()) &&
          hasValidParentUser(userId);
      }

      match /settings/{settingId} {
        allow get: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(settingId) &&
          (isOwner(userId) || isAdmin()) &&
          hasValidParentUser(userId);
        allow list: if isVerifiedUser() &&
          request.auth.uid == userId &&
          resource.data.ownerUid == request.auth.uid;
        allow create: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(settingId) &&
          settingId == 'preferences' &&
          isOwner(userId) &&
          isValidUserPreferences(incoming(), userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          hasValidParentUser(userId);
        allow update: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(settingId) &&
          settingId == 'preferences' &&
          isValidUserPreferences(incoming(), userId) &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            (
              isOwner(userId) &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'adminPin',
                'darkMode',
                'updatedAt'
              ])
            ) ||
            isAdmin()
          ) &&
          hasValidParentUser(userId);
        allow delete: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(settingId) &&
          (isOwner(userId) || isAdmin()) &&
          hasValidParentUser(userId);
      }

      match /attachmentFiles/{attachmentId} {
        allow get: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(attachmentId) &&
          (isOwner(userId) || isAdmin()) &&
          hasValidParentUser(userId);
        allow list: if isVerifiedUser() &&
          request.auth.uid == userId &&
          resource.data.ownerUid == request.auth.uid;
        allow create: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(attachmentId) &&
          isOwner(userId) &&
          isValidAttachmentFile(incoming(), userId, attachmentId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          hasValidParentUser(userId);
        allow update: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(attachmentId) &&
          isValidAttachmentFile(incoming(), userId, attachmentId) &&
          (!('ownerUid' in existing()) || incoming().ownerUid == existing().ownerUid) &&
          (!('id' in existing()) || incoming().id == existing().id) &&
          (!('createdAt' in existing()) ? incoming().createdAt == request.time : incoming().createdAt == existing().createdAt) &&
          incoming().updatedAt == request.time &&
          (
            (
              isOwner(userId) &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'fileName',
                'fileType',
                'fileSize',
                'dataUrl',
                'updatedAt'
              ])
            ) ||
            isAdmin()
          ) &&
